---
import Base from '../../layouts/Base.astro';
import Shared from '../../components/concepts/Shared.astro';
---
<Base title="Concept: Gold 3D" description="Khedar design concept preview." noindex>
  <section class="g3-hero">
    <canvas class="g3-pt" aria-hidden="true"></canvas>
    <div class="wrap g3-in">
      <p class="eyebrow">Technology development & AI agency</p>
      <div class="g3-stage tilt" aria-hidden="true"><span class="g3-word x3d" data-text="KHEDAR"><span class="chrome-gold">KHEDAR</span></span></div>
      <h1>We engineer the systems <span class="chrome-gold">serious products</span> run on.</h1>
      <p class="lead">Khedar designs and builds blockchain platforms, exchanges, wallets, SaaS products, marketplaces and AI automation, with the rigour that real users and real value demand.</p>
      <div class="ctas"><a class="btn btn-primary" href="/contact">Discuss Your Project</a><a class="btn btn-ghost" href="/services">Explore Services</a></div>
    </div>
  </section>
  <Shared variant="gold3d" />
</Base>
<script>
  const c = document.querySelector<HTMLCanvasElement>('.g3-pt')!;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const x = c.getContext('2d')!; let w = 0, h = 0; const d = Math.min(devicePixelRatio, 2);
    const size = () => { w = c.clientWidth; h = c.clientHeight; c.width = w * d; c.height = h * d; x.setTransform(d, 0, 0, d, 0, 0); };
    size(); addEventListener('resize', size);
    const ps = Array.from({ length: 70 }, () => ({ x: Math.random(), y: Math.random(), r: Math.random() * 1.6 + .3, s: Math.random() * .0006 + .0002, a: Math.random() }));
    let on = true; new IntersectionObserver(([e]) => (on = e.isIntersecting)).observe(c);
    const tick = () => { if (on) { x.clearRect(0, 0, w, h); for (const p of ps) { p.y -= p.s; if (p.y < 0) p.y = 1; p.a += .02; x.globalAlpha = .35 + Math.sin(p.a) * .3; x.fillStyle = '#e8d08a'; x.beginPath(); x.arc(p.x * w, p.y * h, p.r, 0, 7); x.fill(); } } requestAnimationFrame(tick); };
    tick();
  }
</script>
<style>
.g3-hero{position:relative;overflow:clip;padding:clamp(3rem,7vw,5.5rem) 0 clamp(3rem,6vw,5rem);text-align:center;isolation:isolate}
.g3-hero::before{content:"";position:absolute;inset:0;z-index:-2;background:radial-gradient(50rem 22rem at 50% 38%,rgba(201,162,39,.2),transparent 70%)}
.g3-pt{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
.g3-in{display:flex;flex-direction:column;align-items:center}
.g3-in .eyebrow::before{display:none}
.g3-stage{perspective:1000px;transform:perspective(1000px) rotateX(calc(var(--rx,0deg) + 8deg)) rotateY(var(--ry,0));transition:transform .6s var(--ease);margin:.5rem 0 1.5rem}
.g3-word{display:block;font:800 clamp(4.2rem,17vw,15rem)/.9 var(--display);letter-spacing:-.05em}
.g3-word.x3d::before{text-shadow:1px 1px 0 #6b5212,2px 2px 0 #5c460f,3px 3px 0 #4f3c0c,4px 4px 0 #43330a,5px 5px 0 #382a08,6px 6px 0 #2d2206,7px 7px 0 #241b05,8px 8px 0 #1c1504,10px 22px 40px rgba(0,0,0,.9),0 0 80px rgba(201,162,39,.35)}
.g3-hero h1{font-size:clamp(1.9rem,4vw,3.4rem);max-width:22ch;margin-inline:auto}
.g3-hero .lead{margin-inline:auto;max-width:56ch}
.ctas{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.5rem;justify-content:center}
</style>
