---
import Base from '../../layouts/Base.astro';
import Shared from '../../components/concepts/Shared.astro';
const facets = [
  ['300,40 420,200 300,250', 'f1'], ['300,40 180,200 300,250', 'f2'], ['180,200 300,250 300,470', 'f3'],
  ['420,200 300,250 300,470', 'f4'], ['300,40 420,200 470,150', 'f5'], ['300,40 180,200 130,150', 'f6'],
];
---
<Base title="Concept: Crystal" description="Khedar design concept preview." noindex>
  <section class="cr-hero">
    <div class="wrap cr-in">
      <div class="cr-copy">
        <p class="eyebrow">Technology development & AI agency</p>
        <h1 class="x3d" data-text="We engineer the systems serious products run on."><span class="chrome-gold">We engineer the systems serious products run on.</span></h1>
        <p class="lead">Khedar designs and builds blockchain platforms, exchanges, wallets, SaaS products, marketplaces and AI automation, with the rigour that real users and real value demand.</p>
        <div class="ctas"><a class="btn btn-primary" href="/contact">Discuss Your Project</a><a class="btn btn-ghost" href="/services">Explore Services</a></div>
      </div>
      <div class="cr-art tilt" aria-hidden="true">
        <div class="cr-beam"></div>
        <svg viewBox="0 0 600 520" shape-rendering="geometricPrecision">
          <defs>
            <linearGradient id="f1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff8e1" stop-opacity="1"/><stop offset="1" stop-color="#c9a227" stop-opacity=".55"/></linearGradient>
            <linearGradient id="f2" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e6e8ee" stop-opacity=".85"/><stop offset="1" stop-color="#8d929c" stop-opacity=".35"/></linearGradient>
            <linearGradient id="f3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffc93c" stop-opacity=".7"/><stop offset="1" stop-color="#8c5e0c" stop-opacity=".45"/></linearGradient>
            <linearGradient id="f4" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff3c4" stop-opacity=".95"/><stop offset="1" stop-color="#d89a12" stop-opacity=".4"/></linearGradient>
            <linearGradient id="f5" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#e8d08a" stop-opacity=".1"/></linearGradient>
            <linearGradient id="f6" x1="1" y1="0" x2="0" y2="0"><stop offset="0" stop-color="#eef0f4" stop-opacity=".8"/><stop offset="1" stop-color="#fff" stop-opacity=".3"/></linearGradient>
            <filter id="gl"><feGaussianBlur stdDeviation="14"/></filter>
          </defs>
          <ellipse cx="300" cy="490" rx="170" ry="16" fill="#c9a227" opacity=".35" filter="url(#gl)"/>
          <g class="cr-gem">
            {facets.map(([p, g]) => <polygon points={p} fill={`url(#${g})`} stroke="#fffaf0" stroke-width="1.6" stroke-linejoin="round"/>)}
            <polygon points="300,40 330,120 300,110" fill="#fff" opacity=".95"/><polygon points="420,200 440,180 470,150 430,175" fill="#fff" opacity=".8"/><line x1="200" y1="210" x2="290" y2="440" stroke="#fff" stroke-width="2" opacity=".7"/><polyline points="130,150 300,40 470,150" fill="none" stroke="#fff8e1" stroke-width="1.5" opacity=".8"/>
            <line x1="300" y1="250" x2="300" y2="470" stroke="#fff" stroke-opacity=".5"/>
          </g>
          <g class="cr-sp" fill="#fff8e1">
            <circle cx="300" cy="40" r="3"/><circle cx="420" cy="200" r="2"/><circle cx="180" cy="200" r="2"/>
          </g>
        </svg>
      </div>
    </div>
  </section>
  <Shared variant="crystal" />
</Base>
<style>
.cr-hero{position:relative;overflow:clip;padding:clamp(3rem,8vw,6.5rem) 0;isolation:isolate}
.cr-hero::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(36rem 30rem at 72% 42%,rgba(255,210,74,.30),transparent 65%),radial-gradient(60rem 30rem at 50% -10%,rgba(255,255,255,.12),transparent 70%),linear-gradient(180deg,#141210,#0b0a09)}
.cr-in{display:grid;grid-template-columns:1.3fr 1fr;gap:2rem;align-items:center}
@media (max-width:900px){.cr-in{grid-template-columns:1fr}.cr-art{order:-1;width:100%;max-width:300px;margin:0 auto}}
.cr-hero h1{font-size:clamp(2.4rem,5.2vw,4.7rem);font-weight:700}
.ctas{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}
.cr-art{position:relative;transform:perspective(1000px) rotateX(var(--rx,0)) rotateY(var(--ry,0));transition:transform .6s var(--ease)}
.cr-beam{position:absolute;left:-30%;top:38%;width:160%;height:3px;background:linear-gradient(90deg,transparent,rgba(255,248,225,.0) 20%,#fff 48%,#ffd24a 52%,transparent 80%);transform:rotate(-14deg);opacity:.95}
.cr-gem{transform-origin:300px 250px;animation:float 7s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-10px)}}
.cr-sp circle{animation:tw 3s ease-in-out infinite}.cr-sp circle:nth-child(2){animation-delay:1s}.cr-sp circle:nth-child(3){animation-delay:2s}
@keyframes tw{50%{opacity:.2}}
</style>
