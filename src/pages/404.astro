---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you requested could not be found." noindex>
  <section class="page-hero" style="min-height:55vh"><div class="wrap">
    <p class="eyebrow">Error 404</p>
    <h1>This route has no node.</h1>
    <p class="lead">The page you were looking for does not exist or has moved.</p>
    <div style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.5rem"><a class="btn btn-primary" href="/">Back to home</a><a class="btn btn-ghost" href="/services">View services</a></div>
  </div></section>
</Base>
