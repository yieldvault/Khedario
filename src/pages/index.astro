---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { svc, why, steps } from '../data/home';
const n = (i: number) => String(i + 1).padStart(2, '0');
const email = site.contact.email;
---
<Base title="Khedar | Blockchain, AI & Custom Software Development" description="Build smart contracts, DEX and CEX platforms, crypto wallets, SaaS products, shopping portals, and AI automation with 20 years of technology experience.">
  <section class="hero" id="home">
    <div class="lc-blob" aria-hidden="true"><i></i><i></i></div><span class="sparkle" style="top:12%;left:62%;animation-delay:0s" aria-hidden="true"></span><span class="sparkle" style="top:30%;left:88%;animation-delay:1.1s" aria-hidden="true"></span><span class="sparkle" style="top:70%;left:72%;animation-delay:2s" aria-hidden="true"></span><span class="sparkle" style="top:85%;left:95%;animation-delay:0.6s" aria-hidden="true"></span><span class="sparkle" style="top:20%;left:40%;animation-delay:1.6s" aria-hidden="true"></span>
    <div class="wrap hero-in">
      <div class="lc-panel reveal">
        <p class="eyebrow">Khedar · Technology & AI Agency</p>
        <h1>Engineering <span class="metal">Tomorrow’s</span> Digital Businesses.</h1>
        <p class="sub">Blockchain. AI. Software. Commerce.<br />Built around your ambition.</p>
        <p class="lead">Turn complex ideas into powerful digital products. Khedar designs and develops smart contracts, exchanges, wallets, SaaS platforms, shopping portals, and AI-powered business systems—from initial strategy to launch and ongoing evolution.</p>
        <p class="badge"><b>20</b> Years of Technology Experience. A Future-Focused Approach.</p>
        <div class="ctas"><a class="btn btn-primary" href="#contact">Discuss Your Project</a><a class="btn btn-ghost" href="#services">Explore Our Services</a></div>
      </div>
    </div>
  </section>
  <div class="marquee" aria-hidden="true"><div class="mq-track">{[0,1].map(() => <span>{svc.map((x) => <><b>{x[0]}</b><i>✦</i></>)}</span>)}</div></div>

  <section class="section"><div class="wrap prose reveal">
    <p class="eyebrow">Introduction</p>
    <h2>Your Vision Deserves More Than a Development Vendor.</h2>
    <p class="lead">It needs a technology partner who understands how architecture, user experience, security, and business operations work together.</p>
    <blockquote>We connect product strategy with hands-on engineering to help you build platforms people can use, businesses can operate, and teams can grow.</blockquote>
    <p>Whether you are launching a new venture or modernizing an established business, we turn your requirements into a clear roadmap and a working product.</p>
  </div></section>

  <section class="section" id="services"><div class="wrap">
    <div class="prose reveal"><p class="eyebrow">Our Services</p><h2>Complex Technology. <span class="metal">Clear Business Purpose.</span></h2></div>
    <div class="svc">
      {svc.map(([t, h, d, caps], i) => (
        <article class="glass card sv reveal" style={`transition-delay:${(i % 2) * 80}ms`}>
          <p class="idx">{n(i)}</p>
          <h3>{t}</h3>
          <p class="hl2">{h}</p>
          <p>{d}</p>
          <details><summary>Capabilities</summary><ul class="list">{caps.map((c) => <li>{c}</li>)}</ul></details>
        </article>
      ))}
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <div class="prose reveal"><p class="eyebrow">Why Work With Us</p><h2>Experience That Shapes Better Decisions.</h2></div>
    <div class="why">{why.map(([t, d], i) => <div class={`glass card reveal${i === 0 ? ' big' : ''}`}>{i === 0 && <p class="num metal">20</p>}<h3>{t}</h3><p>{d}</p></div>)}</div>
  </div></section>

  <section class="section" id="approach"><div class="wrap">
    <div class="prose reveal"><p class="eyebrow">Our Approach</p><h2>From First Conversation to Working Product.</h2></div>
    <ol class="tl">{steps.map(([t, d], i) => <li class="reveal"><span class="dot">{n(i)}</span><div><h3>{t}</h3><p>{d}</p></div></li>)}</ol>
  </div></section>

  <section class="section" id="about"><div class="wrap prose reveal">
    <p class="eyebrow">About</p>
    <h2>Two Decades of Experience. <span class="metal">Focused on What Comes Next.</span></h2>
    <p class="lead">Khedar is a technology development and AI agency helping businesses create their next generation of digital products.</p>
    <p>With 20 years of technology experience, we combine practical software engineering with modern blockchain, AI, SaaS, and commerce capabilities.</p>
    <p>Our purpose is straightforward: understand what your business needs, make the technology understandable, and build a product that serves that purpose.</p>
    <blockquote>We believe the strongest digital businesses start with clear thinking—and grow through disciplined execution.</blockquote>
  </div></section>

  <section class="section"><div class="wrap"><div class="glass cta-band reveal">
    <h2>What Will You Build <span class="metal">Next?</span></h2>
    <p class="lead">An exchange. A wallet. A SaaS platform. An intelligent marketplace. An AI-powered operation.</p>
    <p>Let’s turn your next idea into a clear development plan.</p>
    <a class="btn btn-primary" href="#contact">Start Your Project</a>
    <p class="support">Tell us what you want to build, who it serves, and what success looks like.</p>
  </div></div></section>

  <section class="section" id="contact"><div class="wrap form-wrap">
    <div class="prose reveal"><p class="eyebrow">Contact</p><h2>Send Project Enquiry</h2><p>Tell us what you want to build, who it serves, and what success looks like.</p>
      <p class="notice" role="note">Online submission is not connected yet. Pressing the button opens your email app with your enquiry prefilled{email ? '.' : ' (business email to be added: [Business Email]).'}</p></div>
    <form class="glass form reveal" id="enq" data-email={email} novalidate>
      <label>Name<input name="name" required autocomplete="name" /></label>
      <label>Business email<input name="email" type="email" required autocomplete="email" /></label>
      <label>Company name<input name="company" autocomplete="organization" /></label>
      <label>Service required<select name="service" required><option value="">Select a service</option>{svc.map(([t]) => <option>{t}</option>)}</select></label>
      <label class="full">Project overview<textarea name="overview" rows="5" required></textarea></label>
      <label>Estimated budget <small>(optional)</small><input name="budget" /></label>
      <label>Target timeline <small>(optional)</small><input name="timeline" /></label>
      <button class="btn btn-primary full" type="submit">Send Project Enquiry</button>
      <p class="full msg" aria-live="polite"></p>
    </form>
  </div></section>
</Base>
<script>
  const f = document.getElementById('enq') as HTMLFormElement;
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const m = f.querySelector('.msg')!;
    if (!f.checkValidity()) { f.reportValidity(); return; }
    const d = new FormData(f); const to = f.dataset.email || '';
    const body = ['Name', 'name', 'Business email', 'email', 'Company', 'company', 'Service', 'service', 'Budget', 'budget', 'Timeline', 'timeline', 'Overview', 'overview']
      .reduce((a, _, i, arr) => i % 2 ? a : a + `${arr[i]}: ${d.get(arr[i + 1]) || '-'}\n`, '');
    if (!to) { m.textContent = 'Thanks! The business email ([Business Email]) is not configured yet, so the enquiry cannot be sent from this preview.'; return; }
    location.href = `mailto:${to}?subject=${encodeURIComponent('Project enquiry: ' + d.get('service'))}&body=${encodeURIComponent(body)}`;
  });
</script>
<style>
.hero{position:relative;isolation:isolate;min-height:88vh;display:flex;align-items:center;padding:3rem 0;overflow:clip}
.hero-in .lc-panel{max-width:46rem}
.sub{font-size:clamp(1.3rem,2.4vw,1.75rem);color:var(--text);font-weight:600;line-height:1.35;letter-spacing:-.02em}
.badge{display:inline-flex;gap:.6rem;align-items:center;font-size:.95rem;color:var(--soft);border:1px solid rgba(255,214,102,.3);border-radius:999px;padding:.45rem 1rem}
.badge b{font-size:1.2rem;color:var(--cyan)}
.ctas{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:.6rem}
.marquee{overflow:hidden;border-block:1px solid var(--line);padding:1rem 0;white-space:nowrap}
.mq-track{display:inline-flex;animation:mq 50s linear infinite}.mq-track span{display:inline-flex;gap:1.5rem;padding-right:1.5rem;align-items:center}
.mq-track b{color:var(--text);font-weight:600}.mq-track i{color:var(--cyan);font-style:normal}
@keyframes mq{to{transform:translateX(-50%)}}
.prose{max-width:46rem}
.prose p,.section p{font-size:1.125rem;line-height:1.75}
.lead{font-size:clamp(1.2rem,2vw,1.4rem)!important;color:var(--soft)}
blockquote{margin:2rem 0;padding:.4rem 0 .4rem 1.6rem;border-left:3px solid var(--cyan);font-size:clamp(1.2rem,2vw,1.4rem);line-height:1.6;color:var(--text)}
.svc{display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,30rem),1fr));margin-top:2rem}
.idx{font:500 .85rem var(--mono);color:var(--cyan);letter-spacing:.14em;margin-bottom:.8rem!important}
.sv h3{font-size:1.5rem}.hl2{color:var(--text)!important;font-weight:600;margin-bottom:.8rem!important}
.sv p{margin-bottom:1rem!important}
details{border-top:1px solid var(--line);padding-top:1rem;margin-top:1.2rem}
summary{cursor:pointer;color:var(--cyan);font-weight:600;list-style:none;display:flex;justify-content:space-between;min-height:44px;align-items:center}
summary::-webkit-details-marker{display:none}summary::after{content:"+";font-size:1.4rem}details[open] summary::after{content:"–"}
details .list{margin-top:.8rem}
.why{display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));margin-top:2rem}
.why .big{grid-row:span 2}.num{font-size:5.5rem;font-weight:800;line-height:1;margin:0 0 .5rem!important;letter-spacing:-.05em}
.why h3{font-size:1.25rem}
.tl{list-style:none;padding:0;margin:2.5rem 0 0;position:relative;display:grid;gap:2rem;max-width:46rem}
.tl::before{content:"";position:absolute;left:1.6rem;top:0;bottom:0;width:1px;background:linear-gradient(var(--cyan),transparent)}
.tl li{display:flex;gap:1.5rem;align-items:flex-start}
.dot{flex:0 0 3.2rem;height:3.2rem;border-radius:50%;display:grid;place-items:center;font:500 .9rem var(--mono);color:var(--on-acc);background:var(--grad);box-shadow:0 0 24px -4px rgba(var(--a1),.6);position:relative}
.tl h3{font-size:1.35rem;margin-bottom:.3rem}.tl p{margin:0}
.cta-band{display:flex;flex-direction:column;align-items:center}.support{font-size:1rem!important;margin-top:1rem}
.form-wrap{display:grid;gap:2.5rem;grid-template-columns:1fr 1.3fr;align-items:start}
@media (max-width:900px){.form-wrap{grid-template-columns:1fr}}
.notice{border:1px dashed rgba(var(--a1),.5);border-radius:12px;padding:1rem;font-size:1rem!important;color:var(--soft)}
.form{padding:clamp(1.25rem,3vw,2rem);display:grid;gap:1.1rem;grid-template-columns:1fr 1fr}
@media (max-width:600px){.form{grid-template-columns:1fr}}
.form label{display:grid;gap:.4rem;color:var(--text);font-weight:600;font-size:.95rem}.form small{color:var(--muted);font-weight:400}
.form .full{grid-column:1/-1}
input,select,textarea{font:inherit;font-weight:400;font-size:1rem;color:var(--text);background:rgba(0,0,0,.35);border:1px solid var(--line-hi);border-radius:10px;padding:.8rem .9rem;min-height:48px;width:100%}
select option{background:#111}
.msg{margin:0;font-size:.95rem!important;color:var(--cyan)}
</style>
