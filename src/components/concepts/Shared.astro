---
import { services } from '../../data/services';
const pick = services.slice(0, 3);
interface Props { variant: string }
const { variant } = Astro.props;
---
<section class={`c-sec c-${variant}`}>
  <div class="wrap">
    <p class="eyebrow">Services</p>
    <h2>Eight disciplines, one engineering standard.</h2>
    <ul class="c-cards" role="list">
      {pick.map((s, i) => (
        <li class="c-card tilt">
          <span class="c-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3><a href={`/services/${s.slug}`}>{s.title}</a></h3>
          <p>{s.summary}</p>
        </li>
      ))}
    </ul>
    <p class="c-note">Concept preview. Not linked from the live site.</p>
  </div>
</section>
<script>
  const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!rm) {
    const els = document.querySelectorAll<HTMLElement>('.tilt');
    addEventListener('pointermove', (e) => {
      const x = e.clientX / innerWidth - .5, y = e.clientY / innerHeight - .5;
      els.forEach((el) => { el.style.setProperty('--rx', `${(-y * 8).toFixed(2)}deg`); el.style.setProperty('--ry', `${(x * 10).toFixed(2)}deg`); });
    }, { passive: true });
  }
</script>
<style is:global>
.c-sec{padding:clamp(3rem,7vw,6rem) 0}
.c-cards{list-style:none;padding:0;margin:2rem 0 0;display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr))}
.c-card{position:relative;padding:2rem;border-radius:22px;background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.015));border:1px solid rgba(232,208,138,.22);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 30px 60px -30px rgba(0,0,0,.8);transform:perspective(900px) rotateX(var(--rx,0)) rotateY(var(--ry,0));transition:transform .5s var(--ease),border-color .3s}
.c-card:hover,.c-card:focus-within{border-color:rgba(232,208,138,.55)}
.c-card h3 a{color:var(--text);text-decoration:none}.c-card h3 a::after{content:"";position:absolute;inset:0}
.c-card p{margin:0;font-size:.98rem}
.c-idx{display:block;font:500 .75rem var(--mono);letter-spacing:.14em;color:var(--emerald);margin-bottom:2.2rem}
.c-note{margin-top:2rem;font:500 .75rem var(--mono);letter-spacing:.1em;color:var(--muted)}
.chrome-gold{background:linear-gradient(180deg,#fff8e1 0%,#e8d08a 28%,#a8861f 52%,#f1e2b0 64%,#c9a227 82%,#6b5212 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.x3d{position:relative;isolation:isolate}
.x3d::before{content:attr(data-text) / "";position:absolute;inset:0;z-index:-1;color:#2a1f06;text-shadow:1px 1px 0 #4a3a10,2px 2px 0 #3f310d,3px 3px 0 #36290a,4px 4px 0 #2d2208,5px 5px 0 #241b06,6px 6px 0 #1c1504,8px 14px 24px rgba(0,0,0,.8),0 0 40px rgba(201,162,39,.25)}
@media (prefers-reduced-motion:reduce){.c-card{transform:none}}
</style>
