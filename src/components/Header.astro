---
import { site } from '../config/site';
const links = [ ['Home', '/'], ['Services', '/#services'], ['Our Approach', '/#approach'], ['About', '/#about'], ['Contact', '/#contact'] ];
const cur = Astro.url.pathname.replace(/\/$/, '');
---
<header class="hdr">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <svg width="34" height="34" aria-hidden="true" viewBox="0 0 128 128"><defs><linearGradient id="hg0" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F2CF7A"/><stop offset="1" stop-color="#D4A548"/></linearGradient><linearGradient id="hg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#D4A548"/><stop offset="1" stop-color="#9C7124"/></linearGradient><linearGradient id="hg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9C7124"/><stop offset="1" stop-color="#7a5a1c"/></linearGradient><linearGradient id="hc0" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FBF5E8"/><stop offset="1" stop-color="#EDE3CF"/></linearGradient><linearGradient id="hc1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#EDE3CF"/><stop offset="1" stop-color="#CFC2A6"/></linearGradient><linearGradient id="hc2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#CFC2A6"/><stop offset="1" stop-color="#B3A587"/></linearGradient></defs><polygon points="64.00,1.16 83.92,12.66 64.00,24.16 44.08,12.66" fill="url(#hg0)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="44.08,12.66 64.00,24.16 64.00,47.16 44.08,35.66" fill="url(#hg1)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="83.92,12.66 64.00,24.16 64.00,47.16 83.92,35.66" fill="url(#hg2)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="29.50,21.08 49.42,32.58 29.50,44.08 9.58,32.58" fill="url(#hc0)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="9.58,32.58 29.50,44.08 29.50,67.08 9.58,55.58" fill="url(#hc1)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="49.42,32.58 29.50,44.08 29.50,67.08 49.42,55.58" fill="url(#hc2)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="98.50,21.08 118.42,32.58 98.50,44.08 78.58,32.58" fill="url(#hc0)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="78.58,32.58 98.50,44.08 98.50,67.08 78.58,55.58" fill="url(#hc1)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="118.42,32.58 98.50,44.08 98.50,67.08 118.42,55.58" fill="url(#hc2)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="98.50,60.92 118.42,72.42 98.50,83.92 78.58,72.42" fill="url(#hg0)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="78.58,72.42 98.50,83.92 98.50,106.92 78.58,95.42" fill="url(#hg1)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="118.42,72.42 98.50,83.92 98.50,106.92 118.42,95.42" fill="url(#hg2)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="29.50,60.92 49.42,72.42 29.50,83.92 9.58,72.42" fill="url(#hg0)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="9.58,72.42 29.50,83.92 29.50,106.92 9.58,95.42" fill="url(#hg1)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="49.42,72.42 29.50,83.92 29.50,106.92 49.42,95.42" fill="url(#hg2)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="64.00,80.84 83.92,92.34 64.00,103.84 44.08,92.34" fill="url(#hc0)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="44.08,92.34 64.00,103.84 64.00,126.84 44.08,115.34" fill="url(#hc1)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/><polygon points="83.92,92.34 64.00,103.84 64.00,126.84 83.92,115.34" fill="url(#hc2)" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <span class="wm">{site.name}</span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Menu</span><span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="nav-menu" class="nav" aria-label="Primary">
      <ul>
        {links.map(([l, h]) => <li><a href={h} aria-current={h === '/' && cur === '' ? 'page' : undefined}>{l}</a></li>)}
      </ul>
      <a href="/#contact" class="btn btn-primary">Discuss Your Project</a>
    </nav>
  </div>
</header>
<style>
.hdr{position:sticky;top:0;z-index:50;background:rgba(var(--s0),.6);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:1rem}
.logo .wm{font-family:Manrope,var(--display);color:#EDE3CF;font-weight:600;padding-bottom:2px;border-bottom:1px solid rgba(212,165,72,.6)}.logo{display:flex;align-items:center;gap:.6rem;color:var(--text);text-decoration:none;font:600 1.3rem var(--display);letter-spacing:-.04em}
.nav{display:flex;align-items:center;gap:1.2rem}
.nav ul{display:flex;gap:1.8rem;list-style:none;margin:0;padding:0}
.nav ul a{color:var(--muted);text-decoration:none;font-weight:500;font-size:.94rem;padding:.5rem .9rem;border-radius:999px;transition:color .25s,background .25s}
.nav ul{gap:.25rem!important;padding:.3rem!important;border:1px solid var(--line)!important;border-radius:999px;background:rgba(255,255,255,.02)}
.nav ul a:hover{background:rgba(255,255,255,.05)}
.nav ul a:hover,.nav ul a[aria-current]{color:var(--text)}
.nav ul a[aria-current]{background:rgba(var(--a1),.12);color:var(--text)}
@media (max-width:1060px){.nav ul{border:0!important;background:none!important;padding:0!important}}
.menu-btn{display:none;background:none;border:1px solid var(--line-hi);border-radius:10px;width:46px;height:46px;cursor:pointer;place-items:center}
.bars,.bars::before,.bars::after{display:block;width:20px;height:2px;background:var(--text);position:relative;transition:transform .2s}
.bars::before,.bars::after{content:"";position:absolute;left:0}.bars::before{top:-6px}.bars::after{top:6px}
.menu-btn[aria-expanded="true"] .bars{background:transparent}
.menu-btn[aria-expanded="true"] .bars::before{transform:translateY(6px) rotate(45deg)}
.menu-btn[aria-expanded="true"] .bars::after{transform:translateY(-6px) rotate(-45deg)}
@media (max-width:1060px){
  .menu-btn{display:grid}
  .nav{display:none;position:absolute;top:72px;left:0;right:0;flex-direction:column;align-items:stretch;gap:1rem;padding:1.25rem 1.25rem 1.75rem;background:var(--bg2);border-bottom:1px solid var(--line)}
  .nav.open{display:flex}
  .nav ul{flex-direction:column;gap:.25rem}
  .nav ul a{display:block;padding:.8rem .25rem;font-size:1.1rem}
  .nav .btn{justify-content:center}
}
</style>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const nav = document.getElementById('nav-menu')!;
  const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); nav.classList.toggle('open', open); };
  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true'; set(open);
    if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
  });
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); } });
  matchMedia('(min-width: 1061px)').addEventListener('change', (m) => m.matches && set(false));
</script>
