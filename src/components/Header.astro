---
import { site } from '../config/site';
const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/#services' },
  { label: 'Our Approach', href: '/#approach' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
  {
    label: 'Auto Trading Agent',
    href: 'https://auraquantagents.online/?ref=0xa8772e8cedd691f79c98f62b091fd60da5741a12',
    external: true,
  },
] as const;
const cur = Astro.url.pathname.replace(/\/$/, '');
---
<header class="hdr">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <img src="/khedar-mark.png" width="36" height="36" alt="" decoding="async" />
      <span class="wm">{site.name}</span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Menu</span><span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="nav-menu" class="nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={!('external' in link && link.external) && link.href === '/' && cur === '' ? 'page' : undefined}
              target={'external' in link && link.external ? '_blank' : undefined}
              rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
      <a href="/#contact" class="btn btn-primary">Discuss Your Project</a>
    </nav>
  </div>
</header>
<style>
.hdr{position:sticky;top:0;z-index:50;background:rgba(var(--s0),.6);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:1rem}
.logo .wm{font-family:Manrope,var(--display);color:#EDE3CF;font-weight:600;padding-bottom:2px;border-bottom:1px solid rgba(212,165,72,.6)}.logo{display:flex;align-items:center;gap:.6rem;color:var(--text);text-decoration:none;font:600 1.3rem var(--display);letter-spacing:-.04em}
.nav{display:flex;align-items:center;gap:1.2rem}
.nav ul{display:flex;gap:1.8rem;list-style:none;margin:0;padding:0}
.nav ul a{color:var(--muted);text-decoration:none;font-weight:500;font-size:.94rem;padding:.5rem .9rem;border-radius:999px;transition:color .25s,background .25s}
.nav ul{gap:.25rem!important;padding:.3rem!important;border:1px solid var(--line)!important;border-radius:999px;background:rgba(255,255,255,.02)}
.nav ul a:hover{background:rgba(255,255,255,.05)}
.nav ul a:hover,.nav ul a[aria-current]{color:var(--text)}
.nav ul a[aria-current]{background:rgba(var(--a1),.12);color:var(--text)}
@media (max-width:1060px){.nav ul{border:0!important;background:none!important;padding:0!important}}
.menu-btn{display:none;background:none;border:1px solid var(--line-hi);border-radius:10px;width:46px;height:46px;cursor:pointer;place-items:center}
.bars,.bars::before,.bars::after{display:block;width:20px;height:2px;background:var(--text);position:relative;transition:transform .2s}
.bars::before,.bars::after{content:"";position:absolute;left:0}.bars::before{top:-6px}.bars::after{top:6px}
.menu-btn[aria-expanded="true"] .bars{background:transparent}
.menu-btn[aria-expanded="true"] .bars::before{transform:translateY(6px) rotate(45deg)}
.menu-btn[aria-expanded="true"] .bars::after{transform:translateY(-6px) rotate(-45deg)}
@media (max-width:1060px){
  .menu-btn{display:grid}
  .nav{display:none;position:absolute;top:72px;left:0;right:0;flex-direction:column;align-items:stretch;gap:1rem;padding:1.25rem 1.25rem 1.75rem;background:var(--bg2);border-bottom:1px solid var(--line)}
  .nav.open{display:flex}
  .nav ul{flex-direction:column;gap:.25rem}
  .nav ul a{display:block;padding:.8rem .25rem;font-size:1.1rem}
  .nav .btn{justify-content:center}
}
</style>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const nav = document.getElementById('nav-menu')!;
  const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); nav.classList.toggle('open', open); };
  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true'; set(open);
    if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
  });
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); } });
  matchMedia('(min-width: 1061px)').addEventListener('change', (m) => m.matches && set(false));
</script>
