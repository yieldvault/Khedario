---
import { site } from '../config/site';
const { email, whatsapp, address } = site.contact;
---
<footer class="ftr">
  <div class="wrap cols">
    <div>
      <a href="/" class="name">Khedar</a>
      <p class="tag">Blockchain · AI · SaaS · Digital Commerce</p>
      <p>20 years of technology experience. Engineering what comes next.</p>
    </div>
    <nav aria-label="Footer"><ul>
      <li><a href="/#services">Services</a></li><li><a href="/#about">About</a></li><li><a href="/#contact">Contact</a></li>
      <li><a href="/privacy">Privacy Policy</a></li><li><a href="/terms">Terms</a></li>
    </ul></nav>
    <ul class="ct">
      <li><span>Contact:</span> {email ? <a href={`mailto:${email}`}>{email}</a> : <em class="ph">[Business Email]</em>}</li>
      <li><span>WhatsApp:</span> {whatsapp ? <a href={`https://wa.me/${whatsapp}`} rel="noopener">+{whatsapp}</a> : <em class="ph">[Business Number]</em>}</li>
      <li><span>Location:</span> {address || <em class="ph">[Company Location]</em>}</li>
    </ul>
  </div>
  <div class="wrap base"><p>© {new Date().getFullYear()} Khedar.</p></div>
</footer>
<style>
.ftr{border-top:1px solid transparent;border-image:linear-gradient(90deg,transparent,var(--line-hi),transparent) 1;margin-top:4rem;padding:4rem 0 2rem;background:rgba(var(--s0),.6);font-size:1rem}
.cols{display:grid;gap:2.5rem;grid-template-columns:2fr 1fr 1.4fr}
@media (max-width:760px){.cols{grid-template-columns:1fr}}
.name{font:700 1.7rem var(--display);letter-spacing:-.03em;color:var(--text);text-decoration:none;display:inline-block;margin-bottom:.5rem}
.tag{font:500 .78rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--cyan)}
ul{list-style:none;padding:0;margin:0;display:grid;gap:.6rem}
a{color:var(--muted);text-decoration:none}a:hover{color:var(--cyan)}
.ct span{color:var(--text);font-weight:600}
.ph{font-style:normal;color:var(--cyan);border:1px dashed rgba(var(--a1),.5);border-radius:6px;padding:.05rem .4rem;font-size:.92em}
.base{border-top:1px solid var(--line);margin-top:3rem;padding-top:1.5rem}
.base p{margin:0;font-size:.88rem}
</style>
