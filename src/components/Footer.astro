---
import { site, socialLinks } from '../config/site';
import { services } from '../data/services';
const { email, whatsapp } = site.contact;
---
<footer class="ftr">
  <div class="wrap cols">
    <div>
      <a href="/" class="name">{site.name}</a>
      <p>Technology development and AI agency. 20 years of overall technology experience applied to blockchain, trading platforms, business software and automation.</p>
    </div>
    <nav aria-label="Services"><h2>Services</h2><ul>{services.map((s) => <li><a href={`/services/${s.slug}`}>{s.title}</a></li>)}</ul></nav>
    <nav aria-label="Company"><h2>Company</h2><ul>
      <li><a href="/about">About</a></li><li><a href="/services">All services</a></li><li><a href="/contact">Contact</a></li>
    </ul></nav>
    <div><h2>Contact</h2><ul>
      <li><a href="/contact">Project enquiry form</a></li>
      {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
      {whatsapp && <li><a href={`https://wa.me/${whatsapp}`} rel="noopener">WhatsApp</a></li>}
      {socialLinks.map(([l, h]) => <li><a href={h} rel="noopener me">{l}</a></li>)}
    </ul></div>
  </div>
  <div class="wrap base"><p>© {new Date().getFullYear()} {site.name}. {site.domain}</p></div>
</footer>
<style>
.ftr{border-top:1px solid transparent;border-image:linear-gradient(90deg,transparent,var(--line-hi),transparent) 1;margin-top:4rem;padding:4rem 0 2rem;background:rgba(var(--s0),.6);font-size:.95rem}
.cols{display:grid;gap:2.5rem;grid-template-columns:2fr 1.4fr 1fr 1fr}
@media (max-width:900px){.cols{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.cols{grid-template-columns:1fr}}
.name{font:600 1.5rem var(--display);letter-spacing:-.04em;color:var(--text);text-decoration:none;display:inline-block;margin-bottom:.8rem}
h2{font:500 .72rem var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--text);margin-bottom:1rem}
ul{list-style:none;padding:0;margin:0;display:grid;gap:.45rem}
a{color:var(--muted);text-decoration:none}a:hover{color:var(--cyan)}
.base{border-top:1px solid var(--line);margin-top:3rem;padding-top:1.5rem}
.base p{margin:0;font-size:.88rem}
</style>
