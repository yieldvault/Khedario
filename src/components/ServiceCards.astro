---
import { services } from '../data/services';
import Icon from './Icon.astro';
---
<ul class="grid g4 cards" role="list">
  {services.map((s) => (
    <li class="glass card reveal">
      <div class="icon"><Icon name={s.icon} /></div>
      <h3><a class="stretch" href={`/services/${s.slug}`}>{s.title}</a></h3>
      <p>{s.summary}</p>
      <span class="more" aria-hidden="true">Explore <Icon name="arrow" size={16} /></span>
    </li>
  ))}
</ul>
<style>
.cards{list-style:none;padding:0;margin:0}
.more{display:inline-flex;align-items:center;gap:.35rem;margin-top:1.1rem;color:var(--cyan);font-weight:600;font-size:.9rem}
.card:hover .more{gap:.6rem}
</style>
